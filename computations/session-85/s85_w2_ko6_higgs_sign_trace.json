        "step": 5,
        "label": "Bare mu^2 sign (from a_2, KO-6 signature)",
        "eq": "mu^2_bare ~ (-eps'') * Tr_F(Y^dag Y) / Z_H  ~ (+1)*(+1)/(+1) = 1",
        "mu2_sign_bare": 1
      },
      {
        "step": 6,
        "label": "RG-corrected mu^2 sign at EW vacuum",
        "eq": "mu^2_phys < 0 at EW vacuum; top-Yukawa RG flow per AC-2010 \u00a7V, eq. 5.12 drives mu^2(Lambda) > 0 -> mu^2(M_EW) < 0",
        "mu2_sign_rg": -1
      }
    ],
    "mu2_sign_bare": 1,
