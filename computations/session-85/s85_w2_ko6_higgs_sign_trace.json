  "substitution_chain": {
    "steps": [
      {
        "step": 1,
        "label": "Define KO-6 signs",
        "eq": "eps = J^2, eps' = coef(J gamma = eps' gamma J), eps'' = coef(J D = eps'' D J)",
        "values": {
          "eps": 1,
          "eps_prime": 1,
          "eps_double_prime": -1
