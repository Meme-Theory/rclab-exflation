  "eta_derivation": {
    "chain": [
      {
        "step": 1,
        "label": "KO-6 algebraic identities (from verified toy model)",
        "identities": {
          "J^2 = +1": true,
          "J gamma = +gamma J": true,
          "J D = -D J": true
