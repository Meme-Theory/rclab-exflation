\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Weyl operator eigenvalues of $(\mathrm  {SU}(3),g_\tau )$ on $\Lambda ^2(\mathbb  {R}^8)\cong  \mathbb  {R}^{28}$. At $\tau =0$, the enhanced $\mathrm  {SU}(3)\times \mathrm  {SU}(3)$ symmetry forces exactly two distinct eigenvalues (multiplicities 8 and 20), satisfying the trace-free condition and reproducing $|C|^2(0)=5/14$. For $\tau >0$, all 8 eigenvalues are distinct (Theorem~\ref {thm:typeI}); they are obtained by numerical diagonalization, constrained by the trace-free and $|C|^2(\tau )$ conditions of eq.~\eqref  {eq:weyl_sq}.}}{9}{table.2}\protected@file@percent }
\newlabel{tab:weyl_eigenvalues}{{2}{9}{Weyl operator eigenvalues of $(\mathrm {SU}(3),g_\tau )$ on $\Lambda ^2(\mathbb {R}^8)\cong \mathbb {R}^{28}$. At $\tau =0$, the enhanced $\mathrm {SU}(3)\times \mathrm {SU}(3)$ symmetry forces exactly two distinct eigenvalues (multiplicities 8 and 20), satisfying the trace-free condition and reproducing $|C|^2(0)=5/14$. For $\tau >0$, all 8 eigenvalues are distinct (Theorem~\ref {thm:typeI}); they are obtained by numerical diagonalization, constrained by the trace-free and $|C|^2(\tau )$ conditions of eq.~\eqref {eq:weyl_sq}}{table.2}{}}
